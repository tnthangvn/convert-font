{
  "name": "@tnthangvn/woff-tool",
  "version": "1.0.0",
  "description": "Internal WOFF font generation tool — load/create WOFF, add SVG glyphs, generate & download",
  "main": "server.js",
  "packageManager": "pnpm@10.20.0",
  "bin": {
    "woff-tool": "./mcp-server.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "mcp": "node mcp-server.mjs",
    "test": "node --test 'tests/**/*.test.js'"
  },
  "keywords": [
    "woff",
    "font",
    "svg",
    "icon-font"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "opentype.js": "^1.3.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "svg2ttf": "^6.0.3",
    "svgicons2svgfont": "^15.0.1",
    "ttf2woff": "^3.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": "22.x"
  }
}
