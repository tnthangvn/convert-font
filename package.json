{
  "name": "@tnthangvn/woff-tool",
  "version": "1.3.2",
  "description": "WOFF icon-font tool — load/create WOFF, add SVG glyphs, live SSE preview, generate & download. Includes an MCP server.",
  "main": "server.js",
  "packageManager": "pnpm@10.20.0",
  "bin": {
    "woff-tool": "./mcp-server.mjs"
  },
  "files": [
    "server.js",
    "mcp-server.mjs",
    "lib/",
    "public/",
    "README.md",
    "skills/woff-tool/SKILL.md",
    "skills/rv-icon/SKILL.md",
    "skills/rv-icon/scripts/",
    "skills/svg-to-icon-font/SKILL.md",
    "skills/svg-to-icon-font/scripts/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "mcp": "node mcp-server.mjs",
    "test": "node --test 'tests/**/*.test.js'"
  },
  "keywords": [
    "woff",
    "font",
    "svg",
    "icon-font"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "opentype.js": "^1.3.4",
    "svg2ttf": "^6.0.3",
    "svgicons2svgfont": "^15.0.1",
    "svgpath": "^2.6.0",
    "ttf2woff": "^3.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
